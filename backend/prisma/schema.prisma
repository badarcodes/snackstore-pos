generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  DAMAGE
  EXPIRED
  RETURN
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  STOK_BAHAN
  KEMASAN_DUS_PLASTIK
  TRANSPORTASI
  LISTRIK_AIR_GAS
  GAJI_KARYAWAN
  OPERASIONAL_LAIN
}

enum IncomeCategory {
  MODAL_AWAL
  PENDAPATAN_LAIN
  BONUS_SUPPLIER
}

enum AttendanceStatus {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum LeaveType {
  CUTI_TAHUNAN
  SAKIT
  IZIN
  CUTI_MELAHIRKAN
  CUTI_KHUSUS
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  name          String
  password      String
  role          Role            @default(ADMIN)
  isActive      Boolean         @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sales         Sale[]          @relation("AdminSales")
  cancelledSales Sale[]         @relation("CancelledSales")
  stockMovements StockMovement[]
  purchases     Purchase[]
  expenses      Expense[]
  incomeEntries IncomeEntry[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Product {
  id           Int             @id @default(autoincrement())
  sku          String          @unique
  name         String
  categoryId   Int
  category     Category        @relation(fields: [categoryId], references: [id])
  image        String?
  costPrice    Decimal         @db.Decimal(12, 2)
  sellingPrice Decimal         @db.Decimal(12, 2)
  stock        Int             @default(0)
  unit         String          @default("box")
  minStock     Int             @default(5)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@index([categoryId])
  @@index([name])
  @@index([sku])
  @@map("products")
}

model StockMovement {
  id         Int               @id @default(autoincrement())
  productId  Int
  product    Product           @relation(fields: [productId], references: [id])
  type       StockMovementType
  qtyBefore  Int
  qtyChange  Int
  qtyAfter   Int
  reason     String
  userId     Int
  user       User              @relation(fields: [userId], references: [id])
  refType    String?           // e.g. "SALE", "PURCHASE", "MANUAL"
  refId      String?
  createdAt  DateTime          @default(now())

  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Purchase {
  id            Int            @id @default(autoincrement())
  invoiceNumber String         @unique
  supplierId    Int?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  totalAmount   Decimal        @db.Decimal(12, 2)
  notes         String?
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         PurchaseItem[]
  expenses      Expense[]

  @@index([supplierId])
  @@index([userId])
  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model Sale {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique
  cashierId          Int
  cashier            User          @relation("AdminSales", fields: [cashierId], references: [id])
  totalAmount        Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount        Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  cashReceived       Decimal       @db.Decimal(12, 2)
  changeAmount       Decimal       @db.Decimal(12, 2)
  status             SaleStatus    @default(COMPLETED)
  notes              String?
  cancellationReason String?
  cancelledById      Int?
  cancelledBy        User?         @relation("CancelledSales", fields: [cancelledById], references: [id])
  cancelledAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              SaleItem[]
  payments           Payment[]

  @@index([cashierId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  unitCost    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  qty         Int
  subtotal    Decimal  @db.Decimal(12, 2)
  profit      Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  saleId          Int
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?
  status          String        @default("COMPLETED")
  createdAt       DateTime      @default(now())

  @@index([saleId])
  @@map("payments")
}

model Expense {
  id            Int             @id @default(autoincrement())
  expenseNumber String          @unique
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)
  description   String
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  purchaseId    Int?
  purchase      Purchase?       @relation(fields: [purchaseId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("expenses")
}

model IncomeEntry {
  id            Int            @id @default(autoincrement())
  entryNumber   String         @unique
  category      IncomeCategory
  amount        Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod  @default(CASH)
  description   String
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([category])
  @@index([createdAt])
  @@map("income_entries")
}

// -------------------------------------------------------------
// MODUL KARYAWAN, KEHADIRAN, CUTI & EVALUASI KINERJA HARIAN
// -------------------------------------------------------------

model Employee {
  id                     Int                    @id @default(autoincrement())
  employeeCode           String                 @unique // e.g. "KUE-001"
  name                   String
  position               String                 // e.g. "Kepala Baker", "Baker Kue Basah", "Pelayan Toko & Kasir", "Staff Packing & Display", "Kebersihan"
  phone                  String?
  address                String?
  hireDate               DateTime               @default(now())
  salary                 Decimal?               @db.Decimal(12, 2)
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  attendances            Attendance[]
  leaves                 LeaveRequest[]
  evaluations            DailyEvaluation[]

  @@index([isActive])
  @@index([name])
  @@map("employees")
}

model Attendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  checkIn    String?          // e.g. "07:30"
  checkOut   String?          // e.g. "16:30"
  status     AttendanceStatus @default(HADIR) // HADIR, IZIN, SAKIT, ALPA
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

model LeaveRequest {
  id          Int         @id @default(autoincrement())
  employeeId  Int
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        LeaveType   @default(CUTI_TAHUNAN)
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  daysCount   Int         @default(1)
  reason      String
  status      LeaveStatus @default(PENDING) // PENDING, APPROVED, REJECTED
  adminNotes  String?
  approvedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model DailyEvaluation {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  // 5 Indikator Penilaian Kinerja Karyawan (Skala 1 s.d 5)
  // 1: Sangat Tidak Baik, 2: Tidak Baik, 3: Cukup/Rata-rata, 4: Baik, 5: Sangat Baik
  scoreDiscipline Int      // 1. Kedisiplinan & Ketepatan Waktu
  scoreQuality    Int      // 2. Kualitas Pembuatan Kue, Resep & Higienitas
  scoreService    Int      // 3. Pelayanan Pembeli & Keramahan
  scoreTeamwork   Int      // 4. Kerja Sama Tim & Koordinasi Kerja
  scoreInitiative Int      // 5. Inisiatif Kerja & Tanggung Jawab
  averageScore    Decimal  @db.Decimal(4, 2) // Nilai Rata-rata dari 5 indikator
  notes           String?  // Catatan Evaluasi Harian dari Admin
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("daily_evaluations")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
