generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CASHIER
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  DAMAGE
  EXPIRED
  RETURN
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

enum ExpenseCategory {
  STOK_BAHAN
  KEMASAN_PLASTIK
  TRANSPORTASI
  LISTRIK_AIR
  GAJI
  OPERASIONAL_LAIN
}

enum IncomeCategory {
  MODAL_AWAL
  PENDAPATAN_LAIN
  BONUS_SUPPLIER
}

model User {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  name          String
  password      String
  role          Role            @default(CASHIER)
  isActive      Boolean         @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sales         Sale[]          @relation("CashierSales")
  cancelledSales Sale[]         @relation("CancelledSales")
  stockMovements StockMovement[]
  purchases     Purchase[]
  expenses      Expense[]
  incomeEntries IncomeEntry[]
  cashSessions  CashSession[]
  cashMovements CashMovement[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Product {
  id           Int             @id @default(autoincrement())
  sku          String          @unique
  name         String
  categoryId   Int
  category     Category        @relation(fields: [categoryId], references: [id])
  image        String?
  costPrice    Decimal         @db.Decimal(12, 2)
  sellingPrice Decimal         @db.Decimal(12, 2)
  stock        Int             @default(0)
  unit         String          @default("bungkus")
  minStock     Int             @default(5)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]

  @@index([categoryId])
  @@index([name])
  @@index([sku])
  @@map("products")
}

model StockMovement {
  id         Int               @id @default(autoincrement())
  productId  Int
  product    Product           @relation(fields: [productId], references: [id])
  type       StockMovementType
  qtyBefore  Int
  qtyChange  Int
  qtyAfter   Int
  reason     String
  userId     Int
  user       User              @relation(fields: [userId], references: [id])
  refType    String?           // e.g. "SALE", "PURCHASE", "MANUAL"
  refId      String?
  createdAt  DateTime          @default(now())

  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model Purchase {
  id            Int            @id @default(autoincrement())
  invoiceNumber String         @unique
  supplierId    Int?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  totalAmount   Decimal        @db.Decimal(12, 2)
  notes         String?
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items         PurchaseItem[]
  expenses      Expense[]

  @@index([supplierId])
  @@index([userId])
  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  qty        Int
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model CashSession {
  id             Int               @id @default(autoincrement())
  cashierId      Int
  cashier        User              @relation(fields: [cashierId], references: [id])
  openingCash    Decimal           @db.Decimal(12, 2)
  totalCashSales Decimal           @default(0) @db.Decimal(12, 2)
  totalCashIn    Decimal           @default(0) @db.Decimal(12, 2)
  totalCashOut   Decimal           @default(0) @db.Decimal(12, 2)
  expectedCash   Decimal           @default(0) @db.Decimal(12, 2)
  actualCash     Decimal?          @db.Decimal(12, 2)
  difference     Decimal?          @db.Decimal(12, 2)
  status         CashSessionStatus @default(OPEN)
  notes          String?
  openedAt       DateTime          @default(now())
  closedAt       DateTime?

  sales          Sale[]
  cashMovements  CashMovement[]
  expenses       Expense[]
  incomeEntries  IncomeEntry[]

  @@index([cashierId])
  @@index([status])
  @@map("cash_sessions")
}

model CashMovement {
  id            Int              @id @default(autoincrement())
  cashSessionId Int
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  userId        Int
  user          User             @relation(fields: [userId], references: [id])
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
  @@index([userId])
  @@map("cash_movements")
}

model Sale {
  id                 Int           @id @default(autoincrement())
  invoiceNumber      String        @unique
  cashierId          Int
  cashier            User          @relation("CashierSales", fields: [cashierId], references: [id])
  totalAmount        Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount        Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod @default(CASH)
  cashReceived       Decimal       @db.Decimal(12, 2)
  changeAmount       Decimal       @db.Decimal(12, 2)
  status             SaleStatus    @default(COMPLETED)
  notes              String?
  cancellationReason String?
  cancelledById      Int?
  cancelledBy        User?         @relation("CancelledSales", fields: [cancelledById], references: [id])
  cancelledAt        DateTime?
  cashSessionId      Int?
  cashSession        CashSession?  @relation(fields: [cashSessionId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              SaleItem[]
  payments           Payment[]

  @@index([cashierId])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([cashSessionId])
  @@map("sales")
}

model SaleItem {
  id          Int      @id @default(autoincrement())
  saleId      Int
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   Int?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String
  unitCost    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  qty         Int
  subtotal    Decimal  @db.Decimal(12, 2)
  profit      Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  saleId          Int
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?
  status          String        @default("COMPLETED")
  createdAt       DateTime      @default(now())

  @@index([saleId])
  @@map("payments")
}

model Expense {
  id            Int             @id @default(autoincrement())
  expenseNumber String          @unique
  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  paymentMethod PaymentMethod   @default(CASH)
  description   String
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  purchaseId    Int?
  purchase      Purchase?       @relation(fields: [purchaseId], references: [id])
  cashSessionId Int?
  cashSession   CashSession?    @relation(fields: [cashSessionId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([category])
  @@index([cashSessionId])
  @@index([createdAt])
  @@map("expenses")
}

model IncomeEntry {
  id            Int            @id @default(autoincrement())
  entryNumber   String         @unique
  category      IncomeCategory
  amount        Decimal        @db.Decimal(12, 2)
  paymentMethod PaymentMethod  @default(CASH)
  description   String
  userId        Int
  user          User           @relation(fields: [userId], references: [id])
  cashSessionId Int?
  cashSession   CashSession?   @relation(fields: [cashSessionId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([category])
  @@index([cashSessionId])
  @@index([createdAt])
  @@map("income_entries")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
